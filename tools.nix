# Optional external tools that IPED looks for at runtime.
#
# Anything that cannot be provided is skipped with an evaluation warning, and
# the IPED parser that needs it stays disabled (IPED logs an [ERROR] line for
# it at startup).
#
# Arguments:
#   jdk      JDK used to build jep (only relevant with withJep = true)
#   withJep  also build Jep + a Python for IPED's Python modules (see jep.nix)
#   withWhisper  also put faster-whisper and gputil into that Python, for IPED's
#                local Whisper audio transcription (needs withJep)
#   withWhisperGpu  build CTranslate2 (the engine under faster-whisper) with CUDA
#                   so Whisper can use an NVIDIA GPU (needs withWhisper; the flake
#                   must allow unfree packages; see the README)
#
# Returns:
#   bin        packages whose bin/ goes on PATH
#   lib        packages whose lib/ goes on LD_LIBRARY_PATH (JNA / JNI loaded libs)
#   pythonPath directories for PYTHONPATH (kept for compatibility; the wrapper
#              does not have to use it)
{ pkgs, jdk ? pkgs.jdk11, withJep ? false, withWhisper ? false, withWhisperGpu ? false }:
let
  inherit (pkgs) lib;

  # OCR. IPED's wiki asks for English, Portuguese and OSD data.
  # If "osd" is rejected by your nixpkgs, remove it from this list.
  tesseract = pkgs.tesseract.override {
    enableLanguages = [ "eng" "por" "osd" ];
  };

  # RegRipper (bundled in IPED) is run with `perl rip.pl` and needs this module.
  perlEnv = pkgs.perl.withPackages (ps:
    lib.optional (ps ? ParseWin32Registry) ps.ParseWin32Registry);

  # Windows Recycle Bin parsers. IPED wants the `rifiuti2` and `rifiuti-vista`
  # commands; rifiuti2.nix builds them from source (nixpkgs' `rifiuti` did not
  # satisfy IPED's checks).
  rifiuti = pkgs.rifiuti2 or (pkgs.callPackage ./rifiuti2.nix { });

  # libyal command-line tools and libraries:
  #   libesedb (esedbexport, also loaded via JNA), libevtx (evtxexport),
  #   libevt (evtexport), libscca (sccainfo), libmsiecf (msiecfexport),
  #   libpff (pffexport)
  #
  # The nixpkgs package is used when it exists; otherwise the upstream release
  # tarball is built with libyal.nix. Versions and checksums live in
  # libyal-versions.nix, generated by ./update-libyal.sh (upstream deletes old
  # release assets, so pins go stale and must be regenerated from time to time).
  mkLibyal = pkgs.callPackage ./libyal.nix { };
  libyalLocal = import ./libyal-versions.nix mkLibyal;
  # libagdb (SuperFetch, agdbinfo) is deliberately missing: upstream publishes
  # no downloadable release tarball for it.
  libyalWanted = [ "libesedb" "libevtx" "libevt" "libscca" "libmsiecf" ];

  libyalPkg = name:
    pkgs.${name} or libyalLocal.${name} or
      (lib.warn "iped: no ${name} (nixpkgs or libyal-versions.nix); run ./update-libyal.sh" null);

  yal =
    lib.optional (pkgs ? libpff) pkgs.libpff
    ++ lib.filter (p: p != null) (map libyalPkg libyalWanted);

  # IPED's Python modules go through Jep (Java Embedded Python): Python with
  # the `jep` package, plus libjep.so on LD_LIBRARY_PATH. The Python environment is on
  # PATH; IPED appears to locate jep through it (inferred, not verified). The jep version must match the jep jar in IPED's lib/
  # directory (ls <iped-release>/lib | grep -i jep). See jep.nix.
  # Python 3.11 worked for building jep 4.0.3, but current nixpkgs no longer
  # supports parts of its package set (e.g. sphinx) on 3.11, which breaks
  # packages such as beautifulsoup4. If jep fails to build on 3.12, go back to
  # python311 and remove the extra modules from pythonModules below.
  python = pkgs.python312;
  jepPkg = python.pkgs.callPackage ./jep.nix { inherit jdk; };
  # Python packages that IPED's Python modules import. Add more here as the
  # IPED log reports "No module named '...'".
  #
  # Whisper (withWhisper): IPED's WhisperTranscriptTask needs the Python
  # libraries `faster_whisper` and `gputil` (IPED user manual). Models are
  # downloaded from Hugging Face on first use, so the first run needs network
  # access (or a pre-populated Hugging Face cache).
  pyOpt = ps: name:
    if builtins.hasAttr name ps then [ ps.${name} ]
    else lib.warn "iped: Python package '${name}' not found in nixpkgs; local Whisper transcription will not work" [ ];
  #
  # GPU (withWhisperGpu): faster-whisper only uses the GPU if CTranslate2 was
  # built with CUDA. nixpkgs builds it CPU-only by default, so it is rebuilt
  # with CUDA and cuDNN here. UNTESTED: the override argument names have changed
  # between nixpkgs versions; if this fails with "unexpected argument", the
  # older pattern was faster-whisper.override { ctranslate2 = pkgs.ctranslate2.override { ... }; }.
  fasterWhisper = ps:
    if withWhisperGpu then
      ps.faster-whisper.override {
        ctranslate2 = ps.ctranslate2.override {
          ctranslate2-cpp = pkgs.ctranslate2.override { withCUDA = true; withCuDNN = true; };
        };
      }
    else ps.faster-whisper;
  pythonModules = ps:
    [ jepPkg ps.beautifulsoup4 ]
    ++ lib.optionals withWhisper (
      (if builtins.hasAttr "faster-whisper" ps then [ (fasterWhisper ps) ]
       else lib.warn "iped: Python package 'faster-whisper' not found in nixpkgs; local Whisper transcription will not work" [ ])
      ++ pyOpt ps "gputil");
  jepEnv = python.withPackages pythonModules;
  jepSite = "${jepEnv}/${python.sitePackages}";
  jepLibs = pkgs.runCommand "jep-libs" { } ''
    mkdir -p $out/lib
    ln -s ${jepSite}/jep/*.so* $out/lib/
  '';

  # NixOS exposes the NVIDIA driver libraries (libcuda.so, ...) under
  # /run/opengl-driver/lib. This tiny package only points at that directory so
  # it can be put on LD_LIBRARY_PATH. Harmless on systems where it does not exist.
  driverLibs = pkgs.runCommand "nixos-driver-libs" { } ''
    mkdir -p $out
    ln -s /run/opengl-driver/lib $out/lib
  '';
in
{
  bin =
    [ tesseract pkgs.imagemagick pkgs.mplayer pkgs.graphviz pkgs.libreoffice perlEnv ]
    ++ [ rifiuti ]
    ++ yal
    ++ lib.optional withJep jepEnv;

  # stdenv.cc.cc.lib (libstdc++): Vosk ships a prebuilt libvosk.so that IPED
  # extracts at runtime; on NixOS it can only find libstdc++ through
  # LD_LIBRARY_PATH. This is an assumption (not yet verified), and harmless.
  lib =
    yal ++ lib.optional withJep jepLibs ++ [ pkgs.stdenv.cc.cc.lib ]
    ++ lib.optional withWhisperGpu driverLibs;

  pythonPath = lib.optional withJep jepSite;
}
